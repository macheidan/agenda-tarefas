rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return request.auth.token.email == "machadofabio@gmail.com";
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }

    // Flag booleana no doc settings/{uid} do próprio usuário (ex.: dpEditor,
    // comprasEditor). Só admin escreve settings, então a flag é confiável.
    function hasSettingFlag(flag) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/settings/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/settings/$(request.auth.uid)).data.get(flag, false) == true;
    }

    function isDpEditor() {
      return isAdmin() || hasSettingFlag('dpEditor');
    }

    function isComprasEditor() {
      return isAdmin() || hasSettingFlag('comprasEditor');
    }

    // Estoque Mensal (sub-seção de Suprimentos): permissão própria, separada da
    // de Compras, e por loja — cada uma libera só o campo de contagem da sua
    // loja. `estoqueEditar` é a flag antiga (antes da separação) e vale pelas
    // duas.
    function isEstoqueEditor(lojaFlag) {
      return isAdmin() || hasSettingFlag('estoqueEditar') || hasSettingFlag(lojaFlag);
    }

    // Relatório Estoque (sub-seção de Suprimentos): quem fecha o mês. Congela o
    // relatório (estoqueRelatorios) e vincula o item ao Produto (planilha).
    function isRelatorioEstoqueEditor() {
      return isAdmin() || hasSettingFlag('relatorioEstoqueEditar');
    }

    // Conferir Pedidos (sub-seção de Suprimentos): quem fecha a conferência do
    // pedido contra a nota fiscal — a assistente administrativa.
    function isConferenciaEditor() {
      return isAdmin() || hasSettingFlag('conferenciaEditar');
    }

    function isMotoboysEditor() {
      return isAdmin() || hasSettingFlag('motoboysEditor') ||
        hasSettingFlag('motoboysEditGerente') || hasSettingFlag('motoboysEditAdm') ||
        hasSettingFlag('motoboysEditResultado') || hasSettingFlag('motoboysEditTaxas') ||
        hasSettingFlag('motoboysRoster');
    }

    // Usuários: qualquer logado lê. Cada um cria o seu (sem se auto-aprovar)
    // e atualiza só perfil; admin pode tudo (aprovar/rejeitar/deletar).
    match /users/{uid} {
      allow read: if isSignedIn();
      allow create: if isOwner(uid) && (
        isAdmin() || request.resource.data.get('approved', false) == false
      );
      allow update: if isAdmin() ||
        (isOwner(uid) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['approved']));
      allow delete: if isAdmin();
    }

    // Tarefas: dono lê/escreve as suas, admin lê/escreve todas
    match /tasks/{uid}/items/{taskId} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    // Chat: dono da sala lê/escreve, admin lê/escreve todas
    match /chats/{roomId}/messages/{messageId} {
      allow read, write: if isOwner(roomId) || isAdmin();
    }

    // Notas: dono lê/escreve as suas, admin lê/escreve todas
    match /notes/{noteId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if resource.data.uid == request.auth.uid || isAdmin();
    }

    // Lembretes (post-its do calendário): dono lê/escreve os seus, admin todos
    match /stickyNotes/{noteId} {
      allow read: if isSignedIn() && (resource.data.uid == request.auth.uid || isAdmin());
      allow create: if isSignedIn();
      allow update, delete: if resource.data.uid == request.auth.uid || isAdmin();
    }

    // Ideias: qualquer logado lê e cria, admin pode tudo
    match /ideas/{ideaId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Roteiros: qualquer logado lê, cria e edita; admin deleta
    match /scripts/{scriptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Reels: qualquer logado lê, cria e arquiva; admin aprova/deleta
    match /reels/{reelId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Content Plan: qualquer logado lê/cria/edita/deleta (admin gerencia status)
    match /contentPlan/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isSignedIn();
    }

    // Influencers: qualquer logado lê/cria/edita; admin deleta
    match /influencers/{itemId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Avaliações internas (admin → funcionário): seção substituída pelas
    // pesquisas do Delivery Direto (surveys). Sem tela desde 2026-07-15; as
    // regras ficam só para não perder o acesso aos dados históricos.
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isAdmin();
    }

    // Avaliações (aba "Avaliações"): pesquisas de satisfação do Delivery Direto.
    // O conteúdo da pesquisa vem de scripts/importSurveys.mjs pelo Admin SDK,
    // que ignora estas regras. No cliente a única escrita é arquivar: o hasOnly
    // garante que nota, comentário e cliente não podem ser adulterados junto.
    match /surveys/{surveyId} {
      allow read: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['archived']);
      allow create, delete: if false;
    }

    // Mensagens admin: qualquer logado lê; admin cria/deleta;
    // usuário comum pode atualizar apenas readBy (marcar como lida) sem remover ninguém.
    match /adminMessages/{msgId} {
      allow read: if isSignedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy']) &&
        request.resource.data.readBy.hasAll(resource.data.readBy) &&
        request.auth.uid in request.resource.data.readBy
      );
    }

    // Configurações: dono lê as suas, admin lê/escreve todas.
    // settings/global é lido por qualquer logado (ordem do menu, etc).
    // Exceção de escrita: os campos COMPARTILHADOS de Preços em settings/global
    // (alertas "vistos" da aba Subiram e fornecedores/produtos ocultos) podem ser
    // atualizados por qualquer logado — mas SÓ esses campos (hasOnly), mesmo padrão
    // de readBy (adminMessages) e archived (surveys). Sem isso, o não-admin que vê
    // a aba Subiram clica "Visto", a escrita é rejeitada, o cache otimista é
    // revertido e a linha reaparece. O doc já existe em produção, então update basta.
    match /settings/{uid} {
      allow read: if isOwner(uid) || isAdmin() || uid == 'global';
      allow write: if isAdmin();
      allow update: if uid == 'global' && isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['precosAlertasVistos', 'precosFornecedoresOcultos', 'precosProdutosOcultos']);
    }

    // Base de conhecimento: qualquer logado lê, admin escreve
    match /knowledge/{docId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Departamento Pessoal (lojas, funcionários e escala de faltas):
    // qualquer logado lê (visibilidade controlada por toggle/loja no cliente);
    // só admin ou editor (settings.dpEditor) escreve.
    match /dpStores/{storeId} {
      allow read: if isSignedIn();
      allow write: if isDpEditor();
    }
    match /dpEmployees/{employeeId} {
      allow read: if isSignedIn();
      allow write: if isDpEditor();
    }
    match /dpAbsences/{absenceId} {
      allow read: if isSignedIn();
      allow write: if isDpEditor();
    }
    // Salários (dado sensível): leitura só para admin ou quem tem a flag
    // dpSalariosVisible; escrita só admin (inclui o script de importação, que
    // usa o Firebase Admin SDK e ignora estas regras).
    match /dpSalarios/{salarioId} {
      allow read: if isAdmin() || hasSettingFlag('dpSalariosVisible');
      allow write: if isAdmin();
    }

    // Suprimentos (Compras + Estoque Mensal): qualquer logado lê. O catálogo
    // (fornecedores e cadastro de itens) é só de admin/editor; mas qualquer
    // logado pode ajustar a quantidade do pedido (campo qty) — por isso update
    // de comprasItens libera alteração exclusiva de qty para não-editores.
    // A contagem do estoque não fica aqui: vive em estoqueContagens, por mês.
    match /comprasFornecedores/{fornecedorId} {
      allow read: if isSignedIn();
      allow write: if isComprasEditor();
      // De-para do Conferir Pedidos (qual fornecedor do Supabase assina a nota):
      // quem confere ajusta sozinha, sem virar editora do catálogo.
      allow update: if isComprasEditor() || (
        isConferenciaEditor() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['notaFornecedorId'])
      );
    }
    match /comprasItens/{itemId} {
      allow read: if isSignedIn();
      allow create, delete: if isComprasEditor();
      allow update: if isComprasEditor() || (
        isSignedIn() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['qty'])
      ) || (
        // Equivalência de unidade ({ 'ML': 1 }): a assistente ensina a conversão
        // na primeira vez que a linha aparece, e a tela nunca mais pergunta.
        isConferenciaEditor() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['equiv'])
      );
    }

    // Pedido congelado no clique de "+ Copiar" ('2026-07-30_dame_{fornecedorId}').
    // QUALQUER logado grava: quem monta o pedido é o gerente, que não é
    // necessariamente editor do catálogo. Recopiar no mesmo dia sobrescreve, por
    // isso create e update andam juntos. Apagar é só de admin/editor — o pedido
    // é a prova do que foi pedido, não some por descuido.
    match /comprasPedidos/{id} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if isComprasEditor();
    }

    // Conferência fechada (pedido × nota fiscal), um doc por pedido. Snapshot
    // imutável no padrão de estoqueRelatorios: reabrir = apagar o doc.
    match /comprasConferencias/{id} {
      allow read: if isSignedIn();
      allow write: if isConferenciaEditor();
    }

    // Contagem do Estoque Mensal: um doc por mês e loja ('2026-07_dame'), com o
    // mapa itemId -> quantidade. Qualquer logado lê; escreve só quem pode editar
    // AQUELA loja — a loja está no id do doc, então a regra a lê de lá.
    match /estoqueContagens/{id} {
      allow read: if isSignedIn();
      allow write: if (id.matches('.*_dame') && isEstoqueEditor('estoqueEditarDame'))
                   || (id.matches('.*_lov') && isEstoqueEditor('estoqueEditarLov'));
    }

    // Relatório Estoque congelado: um doc por mês e loja ('YYYY-MM_dame').
    // Qualquer logado lê (a tela já filtra por permissão); só quem fecha o mês
    // escreve — salvar sobrescreve e reabrir apaga.
    match /estoqueRelatorios/{id} {
      allow read: if isSignedIn();
      allow write: if isRelatorioEstoqueEditor();
    }

    // CMV (fichas técnicas): beneficiados e sabores. Qualquer logado lê;
    // só admin/editor de compras escreve (mesma alçada do catálogo de Preços/Compras).
    match /cmvBeneficiados/{id} {
      allow read: if isSignedIn();
      allow write: if isComprasEditor();
    }
    match /cmvSabores/{id} {
      allow read: if isSignedIn();
      allow write: if isComprasEditor();
    }
    // Config do CMV (ex.: base que entra em todas as pizzas, por categoria).
    match /cmvConfig/{id} {
      allow read: if isSignedIn();
      allow write: if isComprasEditor();
    }

    // Motoboys (conferência semanal de entregas — valores pagos à cooperativa):
    // dado sensível; leitura só para admin ou quem vê a seção (motoboysEnabled),
    // escrita para admin/editor (gerente). O importador do Saipos usa o Admin
    // SDK e ignora estas regras.
    match /motoboySemanas/{id} {
      allow read: if isAdmin() || hasSettingFlag('motoboysEnabled');
      allow write: if isMotoboysEditor();
      // Checkbox "Conferido": qualquer usuário da seção pode marcar/desmarcar.
      // O update só passa se mexer exclusivamente no mapa `conferidos`
      // (+ atualizadoEm) — o resto do doc continua restrito a editor.
      allow update: if (isAdmin() || hasSettingFlag('motoboysEnabled')) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['conferidos', 'atualizadoEm']);
      // Adicionar motoboy na semana (aba Cadastro): livre para qualquer usuário
      // da seção. Passa só se o update APENAS acrescentar nomes ao mapa
      // `motoboys` — alterar ou remover entrada existente (ou seja, mexer em
      // lançamento) continua exigindo editor pelo `allow write` acima.
      allow update: if (isAdmin() || hasSettingFlag('motoboysEnabled')) &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['motoboys', 'atualizadoEm']) &&
        request.resource.data.motoboys.diff(resource.data.motoboys).removedKeys().size() == 0 &&
        request.resource.data.motoboys.diff(resource.data.motoboys).changedKeys().size() == 0;
    }
    match /motoboyConfig/{id} {
      allow read: if isAdmin() || hasSettingFlag('motoboysEnabled');
      allow write: if isMotoboysEditor();
      // Mesma ideia do doc da semana: cadastrar nome novo é livre; renomear e
      // arquivar/restaurar (alterar entrada existente) segue restrito à
      // permissão de cadastro (`motoboysRoster`).
      allow update: if (isAdmin() || hasSettingFlag('motoboysEnabled')) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['roster']) &&
        request.resource.data.roster.diff(resource.data.roster).removedKeys().size() == 0 &&
        request.resource.data.roster.diff(resource.data.roster).changedKeys().size() == 0;
      // Loja sem doc de config ainda: o primeiro cadastro cria o doc só com o
      // roster (a config cai no default do hook).
      allow create: if (isAdmin() || hasSettingFlag('motoboysEnabled')) &&
        request.resource.data.keys().hasOnly(['roster']);
    }
    match /motoboyExtras/{id} {
      allow read: if isAdmin() || hasSettingFlag('motoboysEnabled');
      allow write: if isMotoboysEditor();
    }
  }
}
